class Probleme:
    def __init__(self, niveau, fichier, ligne, message):
        self.niveau, self.fichier, self.ligne, self.message = niveau, fichier, ligne, message


class Rapporteur:
    def __init__(self):
        self.liste = []

    def erreur(self, fichier, ligne, message):
        self.liste.append(Probleme("ERREUR", fichier, ligne, message))

    def avertissement(self, fichier, ligne, message):
        self.liste.append(Probleme("AVERTISSEMENT", fichier, ligne, message))

    def info(self, fichier, ligne, message):
        self.liste.append(Probleme("INFO", fichier, ligne, message))

    def compte(self, niveau):
        return sum(1 for p in self.liste if p.niveau == niveau)


# ── Lecture du YAML avec numéros de ligne et détection des clés en double ────────────────────────────────────
class Dico(dict):
    ligne = 0
    lignes_cles = None


class Chargeur(yaml.SafeLoader):
    def __init__(self, flux):
        super().__init__(flux)
        self.doublons = []


def _construire_dico(chargeur, noeud, deep=False):
    chargeur.flatten_mapping(noeud)
    dico = Dico()
    dico.ligne = noeud.start_mark.line + 1
    dico.lignes_cles = {}
    for noeud_cle, noeud_valeur in noeud.value:
        cle = chargeur.construct_object(noeud_cle, deep=True)
        try:
            hash(cle)
        except TypeError:
            raise yaml.constructor.ConstructorError(
                None, None, "une clé ne peut pas être une liste ou un bloc", noeud_cle.start_mark
            )
        if cle in dico:
            chargeur.doublons.append((cle, noeud_cle.start_mark.line + 1))
        dico[cle] = chargeur.construct_object(noeud_valeur, deep=deep)
        dico.lignes_cles[cle] = noeud_cle.start_mark.line + 1
    return dico


Chargeur.add_constructor(yaml.resolver.BaseResolver.DEFAULT_MAPPING_TAG, _construire_dico)

