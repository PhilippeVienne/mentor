{
    "compilerOptions": {
        "target": "es2022",
        "module": "esnext",
        "moduleResolution": "bundler",
        "moduleDetection": "force",
        "lib": ["es2023", "dom"],
        "types": ["node"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": ["*.ts"]
}
