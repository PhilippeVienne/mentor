# Configuration du client Terraform dans cet environnement : les fournisseurs viennent UNIQUEMENT du dossier local
# /opt/terraform-providers (rempli au build). Il n'y a pas de bloc `direct` : aucun téléchargement n'est tenté.
provider_installation {
  filesystem_mirror {
    path    = "/opt/terraform-providers"
    include = ["registry.terraform.io/hashicorp/*"]
  }
}
