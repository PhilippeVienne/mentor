def echec(message, code=1):
    print(message, file=sys.stderr)
    sys.exit(code)


def ok(message="Bien."):
    print(message)


def lire(chemin, quoi=None):
    chemin = Path(chemin)
    if not chemin.is_file():
        echec(f"Le fichier {chemin} n'existe pas.")
    return chemin.read_text(encoding="utf-8", errors="replace")


def env_propre(tmp):
    return {"PATH": os.environ.get("PATH", "/usr/local/bin:/usr/bin:/bin"), "HOME": str(tmp), "LANG": "C.UTF-8",
            "PYTHONDONTWRITEBYTECODE": "1"}


IGNORER = shutil.ignore_patterns("__pycache__", ".git", "db.sqlite3", ".coverage")


# ── 1. Sortie d'une commande ─────────────────────────────────────────────────────────────────────────────────────
def normaliser(ligne):
    """Retire les chemins de dossiers (`/x/y/fichier.py` -> `fichier.py`) : seuls le contenu et le nom comptent."""
    ligne = re.sub(r"(?:[\w.\-]+)?(?:/[\w.\-]+)+/([\w.\-]+)", r"\1", ligne)
    return re.sub(r"\s+", " ", ligne).strip()


