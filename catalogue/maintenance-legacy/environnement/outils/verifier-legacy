def lancer_tests(copie, tmp, venv, cible=None, erreurs=False):
    cmd = [python_venv(venv), "-s", "-E"]
    if erreurs:
        cmd += ["-W", "error::DeprecationWarning"]
    cmd += ["manage.py", "test"] + ([cible] if cible else [])
    res = subprocess.run(cmd, cwd=copie, env=env_propre(tmp), capture_output=True, text=True, timeout=60)
    sortie = res.stdout + res.stderr
    m = re.search(r"Ran (\d+) tests?", sortie)
    return res.returncode == 0 and "\nOK" in sortie, int(m.group(1)) if m else 0, sortie


def cmd_tests(args):
    etape = args[0] if args else ""
    minimum = int(args[1]) if len(args) > 1 else 1
    if etape not in ETAPES_TESTS:
        echec(__doc__)
    cfg = ETAPES_TESTS[etape]
    fichier = Path("adherents/tests.py")
    try:
        arbre = ast.parse(lire(fichier))
    except SyntaxError as exc:
        echec(f"adherents/tests.py contient une erreur de syntaxe : {exc}")
    candidats = []
    for classe in [n for n in ast.walk(arbre) if isinstance(n, ast.ClassDef)]:
        for m in classe.body:
            if isinstance(m, ast.FunctionDef) and m.name.startswith("test") and cfg["cible"](m):
                if any(isinstance(n, ast.Attribute) and n.attr == "fail" for n in ast.walk(m)):
                    continue
                candidats.append((classe.name, m))
    if not candidats:
        echec(f"Il manque {cfg['manque']}.")
    avec_assertion = [(c, m) for c, m in candidats if assertions_reelles(m)]
    if not avec_assertion:
        echec("Ton test n'a aucune vraie assertion : ajoute un `self.assertEqual(...)` qui compare le résultat obtenu "
              "à ce que tu attends (pas `pass`, pas `assertTrue(True)`).")
    with tempfile.TemporaryDirectory() as tmp:
        copie = copie_projet(tmp, fichier)
        bon, nombre, sortie = lancer_tests(copie, tmp, "django31")
        if not bon or nombre < minimum:
            print("\n".join(sortie.strip().splitlines()[-15:]))
            echec(f"Il faut que `manage.py test` réussisse avec au moins {minimum} test(s) (il en a lancé {nombre}).")
        for nom_classe, methode in avec_assertion:
            identifiant = f"adherents.tests.{nom_classe}.{methode.name}"
            bon, nombre, sortie = lancer_tests(copie, tmp, "django31", identifiant)
            if not bon or nombre != 1:
                continue
            detecte = True
            for relatif, ancien, nouveau in cfg["mutations"]:
                cible = copie / relatif
                texte = cible.read_text(encoding="utf-8")
                if ancien not in texte:
                    echec(f"Mutation inapplicable ({relatif} a changé ?).", 2)
                cible.write_text(texte.replace(ancien, nouveau), encoding="utf-8")
                tient, _, _ = lancer_tests(copie, tmp, "django31", identifiant)
                cible.write_text(texte, encoding="utf-8")
                if tient:
                    detecte = False
                    break
            if detecte:
                ok(f"Bien : {identifiant} passe sur le code d'origine et échoue sur le code cassé.")
                return
    echec("Ton test passe aussi quand le code est cassé volontairement : il ne vérifie pas assez. "
          "Compare le résultat à une valeur précise (le nom complet attendu, le code 200, le contenu renvoyé).")


# ── 4. Tests de référence rejoués sur le code de l'apprenant·e ──────────────────────────────────────────────────
def cmd_palier(args):
    venv = args[0] if args else ""
    if venv not in {"django31", "django32", "django42", "django52"}:
        echec(__doc__)
    erreurs = "--erreurs-deprecation" in args
    with tempfile.TemporaryDirectory() as tmp:
        copie = Path(tmp) / "p"
        shutil.copytree(Path.cwd(), copie, ignore=IGNORER)
        for chemin in list(copie.rglob("*.py")):
            if re.fullmatch(r"tests?(_\w+)?\.py|test_\w+\.py", chemin.name) and "migrations" not in chemin.parts:
                chemin.unlink()
        shutil.copy2(REFERENCE, copie / "adherents" / "tests.py")
        shutil.copy2(PROJET / "manage.py", copie / "manage.py")
        bon, nombre, sortie = lancer_tests(copie, tmp, venv, erreurs=erreurs)
        if not bon or nombre != 4:
            print("\n".join(sortie.strip().splitlines()[-20:]))
            echec(f"Les 4 tests de référence doivent réussir sur ton code avec Django ({venv}) : "
                  f"{nombre} test(s) lancé(s).")
        if "--migrations" in args:
            res = subprocess.run([python_venv(venv), "-s", "-E", "manage.py", "makemigrations", "--check", "--dry-run"],
                                 cwd=copie, env=env_propre(tmp), capture_output=True, text=True, timeout=30)
            if res.returncode != 0:
                print(res.stdout + res.stderr)
                echec("`makemigrations --check --dry-run` propose encore des migrations.")
    ok(f"Bien : les 4 tests de référence passent sur ton code avec Django ({venv}).")


# ── 5. Code Python lu par l'AST ──────────────────────────────────────────────────────────────────────────────────
def arbre(chemin):
    try:
        return ast.parse(lire(chemin))
    except SyntaxError as exc:
        echec(f"{chemin} contient une erreur de syntaxe : {exc}")


def fichiers_py(*dossiers):
    for d in dossiers:
        for p in sorted(Path(d).rglob("*.py")):
            if "migrations" not in p.parts:
                yield p


def cmd_code(args):
    mode = args[0] if args else ""
    if mode == "auto-field":
        valeur = None
        for n in arbre("config/settings.py").body:
            if isinstance(n, ast.Assign) and any(isinstance(t, ast.Name) and t.id == "DEFAULT_AUTO_FIELD"
                                                for t in n.targets) and isinstance(n.value, ast.Constant):
                valeur = n.value.value
        if not (isinstance(valeur, str) and re.fullmatch(r"django\.db\.models\.(Big|Small)?AutoField", valeur)):
            echec('config/settings.py doit contenir une vraie ligne DEFAULT_AUTO_FIELD = "django.db.models.AutoField" '
                  "(pas dans un commentaire).")
    elif mode == "urls":
        a = arbre("config/urls.py")
        importe = {(n.module, x.name) for n in ast.walk(a) if isinstance(n, ast.ImportFrom) for x in n.names}
        if ("django.urls", "re_path") not in importe:
            echec("config/urls.py doit importer `re_path` depuis `django.urls`.")
        if any(m == "django.conf.urls" for m, _ in importe):
            echec("config/urls.py importe encore `django.conf.urls` : retire `url`.")
        appels = [n.func.id for n in ast.walk(a) if isinstance(n, ast.Call) and isinstance(n.func, ast.Name)]
        if "re_path" not in appels or "url" in appels:
            echec("Les routes de config/urls.py doivent utiliser `re_path(...)` à la place de `url(...)`.")
    elif mode == "textes-depreces":
        interdits = {"force_text", "ugettext", "ugettext_lazy", "ugettext_noop", "ungettext"}
        for p in fichiers_py("adherents", "config"):
            for n in ast.walk(arbre(p)):
                noms = set()
                if isinstance(n, ast.Name):
                    noms.add(n.id)
                elif isinstance(n, ast.Attribute):
                    noms.add(n.attr)
                elif isinstance(n, (ast.ImportFrom, ast.Import)):
                    noms |= {x.name.split(".")[-1] for x in n.names}
                if noms & interdits:
                    echec(f"{p} utilise encore {', '.join(sorted(noms & interdits))}.")
        utils, modeles = arbre("adherents/utils.py"), arbre("adherents/models.py")
        if not any(isinstance(n, ast.Call) and isinstance(n.func, ast.Name) and n.func.id == "force_str"
                   for n in ast.walk(utils)):
            echec("adherents/utils.py doit appeler `force_str(...)`.")
        if not any(isinstance(n, ast.ImportFrom) and n.module == "django.utils.translation"
                   and any(x.name == "gettext_lazy" for x in n.names) for n in ast.walk(modeles)):
            echec("adherents/models.py doit importer `gettext_lazy` depuis `django.utils.translation`.")
    elif mode == "utc":
        a = arbre("adherents/utils.py")
        for n in ast.walk(a):
            if isinstance(n, ast.ImportFrom) and n.module and n.module.startswith("django.utils.timezone"):
                echec("adherents/utils.py importe encore `django.utils.timezone`.")
            if isinstance(n, ast.ImportFrom) and n.module == "django.utils" and any(x.name == "timezone" for x in n.names):
                echec("adherents/utils.py importe encore `timezone` de Django.")
        if not any(isinstance(n, ast.ImportFrom) and n.module == "datetime" and any(x.name == "timezone" for x in n.names)
                   for n in ast.walk(a)) and not any(isinstance(n, ast.Attribute) and n.attr == "utc"
                                                       and isinstance(n.value, ast.Attribute) and n.value.attr == "timezone"
                                                       for n in ast.walk(a)):
            echec("adherents/utils.py doit utiliser `datetime.timezone.utc` (import depuis `datetime`).")
        if not any(isinstance(n, ast.Attribute) and n.attr == "utc" for n in ast.walk(a)):
            echec("adherents/utils.py doit utiliser `timezone.utc` (celui de `datetime`).")
    elif mode in {"requirements-32", "requirements-52"}:
        motif = r"Django==(3|4|5)\.2\.\d+" if mode == "requirements-32" else r"Django==5\.2\.\d+"
        lignes = [re.sub(r"\s*#.*$", "", l).strip() for l in lire("requirements.txt").splitlines()]
        django = [l for l in lignes if re.match(r"(?i)django\s*[=<>~!]", l)]
        if len(django) != 1 or not re.fullmatch(motif, django[0]):
            echec(f"requirements.txt doit contenir une seule ligne Django, de la forme {motif} (trouvé : {django}).")
    else:
        echec(__doc__)
    ok()


# ── 6. React / Vite : fichiers lus sans leurs commentaires ──────────────────────────────────────────────────────
def sans_commentaires_js(texte):
    """Retire // et /* */ en respectant les chaînes de caractères."""
    sortie, i, n = [], 0, len(texte)
    while i < n:
        c = texte[i]
        if c in "\"'`":
            j = i + 1
            while j < n and texte[j] != c:
                j += 2 if texte[j] == "\\" else 1
            sortie.append(texte[i:j + 1])
            i = j + 1
        elif texte.startswith("//", i):
            while i < n and texte[i] != "\n":
                i += 1
        elif texte.startswith("/*", i):
            j = texte.find("*/", i + 2)
            i = n if j < 0 else j + 2
        else:
            sortie.append(c)
            i += 1
    return "".join(sortie)


def code_normalise(texte):
    return re.sub(r"\s+", " ", sans_commentaires_js(texte)).strip()


def charger_json(chemin):
    try:
        return json.loads(lire(chemin))
    except ValueError as exc:
        echec(f"{chemin} n'est pas un JSON valide : {exc}")


def verifier_package_intact(d):
    for cle, attendu in (("name", "planning-js"), ("version", "0.1.0")):
        if d.get(cle) != attendu:
            echec(f"package.json : la clé « {cle} » doit rester « {attendu} ».")
    for dep in ("react", "react-dom", "@material-ui/core"):
        if dep not in d.get("dependencies", {}):
            echec(f"package.json : `{dep}` doit rester dans `dependencies`.")


class Scripts(HTMLParser):
    def __init__(self):
        super().__init__()
        self.scripts, self.racine = [], False

    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)
        if tag == "script":
            self.scripts.append(attrs)
        if tag == "div" and attrs.get("id") == "root":
            self.racine = True


def cmd_react(args):
    mode = args[0] if args else ""
    if mode == "scripts":
        d = charger_json("package.json")
        verifier_package_intact(d)
        s = d.get("scripts", {})
        if s.get("start") != "vite" or s.get("build") != "vite build" or "test" in s:
            echec('Les scripts doivent être : "start": "vite", "build": "vite build", et pas de script "test".')
    elif mode == "deps":
        d = charger_json("package.json")
        verifier_package_intact(d)
        if "react-scripts" in d.get("dependencies", {}):
            echec("`react-scripts` est encore dans `dependencies`.")
        dev = d.get("devDependencies", {})
        for dep in ("vite", "@vitejs/plugin-react"):
            if not (isinstance(dev.get(dep), str) and re.search(r"\d", dev[dep])):
                echec(f"`{dep}` doit être dans `devDependencies` avec un numéro de version (ex. \"^6.0.0\").")
    elif mode == "vite":
        code = code_normalise(lire("vite.config.js"))
        regles = [
            (r'import \{ ?defineConfig ?\} from ["\']vite["\'];?', "l'import `defineConfig` depuis \"vite\""),
            (r'import react from ["\']@vitejs/plugin-react["\'];?', "l'import `react` depuis \"@vitejs/plugin-react\""),
            (r"export default defineConfig\(\{", "`export default defineConfig({ ... })`"),
            (r"plugins: ?\[ ?react\(\) ?\]", "`plugins: [react()]`"),
            (r'build: ?\{ ?outDir: ?["\']build["\'] ?,? ?\}', 'le dossier de sortie : `build: { outDir: "build" }`'),
        ]
        for motif, nom in regles:
            if not re.search(motif, code):
                echec(f"vite.config.js doit contenir {nom} (hors commentaires).")
    elif mode == "index-html":
        if Path("public/index.html").exists():
            echec("public/index.html existe encore : déplace-le à la racine du projet.")
        p = Scripts()
        p.feed(lire("index.html"))
        if not p.racine:
            echec('index.html doit garder la balise <div id="root">.')
        if not any(a.get("type") == "module" and a.get("src") == "/src/index.jsx" for a in p.scripts):
            echec('index.html doit charger `/src/index.jsx` avec <script type="module" src="/src/index.jsx"></script> '
                  "(une balise en commentaire ne compte pas).")
    elif mode in {"renommage", "variable"}:
        index_ref = (OPT / "04-react/src/index.js").read_text(encoding="utf-8")
        app_ref = (OPT / "04-react/src/App.js").read_text(encoding="utf-8")
        app_vite = app_ref.replace("process.env.REACT_APP_API_URL", "import.meta.env.VITE_API_URL")
        for ancien in ("src/index.js", "src/App.js"):
            if Path(ancien).exists():
                echec(f"{ancien} existe encore : renomme-le en .jsx.")
        if code_normalise(lire("src/index.jsx")) != code_normalise(index_ref):
            echec("src/index.jsx doit être l'ancien src/index.js renommé, sans autre changement.")
        app = code_normalise(lire("src/App.jsx"))
        if mode == "renommage":
            if app not in (code_normalise(app_ref), code_normalise(app_vite)):
                echec("src/App.jsx doit être l'ancien src/App.js renommé (seule la variable d'environnement a le droit "
                      "de changer).")
        else:
            if app != code_normalise(app_vite):
                echec("src/App.jsx doit lire `import.meta.env.VITE_API_URL` à la place de "
                      "`process.env.REACT_APP_API_URL`, sans autre changement.")
            for p in Path("src").rglob("*"):
                if p.is_file() and "REACT_APP" in p.read_text(encoding="utf-8", errors="replace"):
                    echec(f"{p} contient encore REACT_APP.")
    else:
        echec(__doc__)
    ok()


# ── 7. Renovate ──────────────────────────────────────────────────────────────────────────────────────────────────
def cmd_renovate(args):
    etape = args[0] if args else ""
    d = charger_json("renovate.json")
    origine = json.loads((OPT / "05-renovate/renovate.json").read_text(encoding="utf-8"))
    for cle in ("labels", "vulnerabilityAlerts"):
        if d.get(cle) != origine[cle]:
            echec(f"renovate.json : la clé « {cle} » doit rester inchangée.")
    regles = d.get("packageRules", [])
    if etape == "1":
        ext = d.get("extends")
        if not (isinstance(ext, list) and "config:recommended" in ext and "config:base" not in ext):
            echec('`extends` doit contenir "config:recommended" à la place de "config:base".')
    elif etape == "2":
        if d.get("dependencyDashboard") is not True or d.get("dependencyDashboardApproval") is not True \
                or "masterIssue" in d or "masterIssueApproval" in d:
            echec("Renomme masterIssue en dependencyDashboard et masterIssueApproval en dependencyDashboardApproval "
                  "(valeur true).")
    elif etape in {"3", "4", "5"}:
        plafonds = [r for r in regles if r.get("matchPackageNames") == ["django"]]
        if etape == "3" and not any(r.get("allowedVersions") in ("<3.3", "<4.3") for r in plafonds):
            echec('Ajoute une règle { "matchPackageNames": ["django"], "allowedVersions": "<3.3" }.')
        lot = [r for r in regles if r.get("groupName") == "dépendances Django"]
        if etape in {"4", "5"} and not any(set(r.get("matchPackageNames", [])) == {"djangorestframework",
                                                                                   "django-import-export"} for r in lot):
            echec('Ajoute une règle qui regroupe djangorestframework et django-import-export dans le lot '
                  '"dépendances Django".')
        if etape == "5":
            if len(regles) != 2 or not any(r.get("allowedVersions") == "<4.3" for r in plafonds):
                echec('Il doit rester deux règles, dont celle qui plafonne django à "<4.3".')
            if any(r.get("allowedVersions") == "<3.3" for r in regles):
                echec('Le plafond "<3.3" doit avoir disparu.')
    else:
        echec(__doc__)
    ok()


# ── 8. Documents Markdown : commentaires ignorés ─────────────────────────────────────────────────────────────────
def markdown_utile(chemin):
    return re.sub(r"<!--.*?-->", "", lire(chemin), flags=re.S)


def cmd_doc(args):
    mode = args[0] if args else ""
    if mode == "journal":
        texte = markdown_utile("docs/montees-de-version.md")
        m = re.search(r"(?m)^##\s+Django 3\.1 vers 3\.2\b.*$", texte)
        if not m:
            echec("Il manque le titre `## Django 3.1 vers 3.2`.")
        corps = re.split(r"(?m)^##\s", texte[m.end():], maxsplit=1)[0]
        for rubrique in ("Pourquoi", "Laissé de côté", "Retour arrière"):
            ligne = re.search(rf"(?m)^[-*]\s+{rubrique}\s*[: ]+\s*(.+)$", corps)
            if not ligne or len(re.findall(r"\w{2,}", ligne.group(1))) < 3:
                echec(f"Complète la ligne `- {rubrique} : ...` avec une vraie phrase (au moins trois mots).")
    elif mode == "readme":
        texte = markdown_utile("README.md")
        for motif, nom in ((r"Python 3\.10", "Python 3.10"), (r"Django 5\.2", "Django 5.2"),
                           (r"manage\.py test", "python manage.py test")):
            if not re.search(motif, texte):
                echec(f"README.md doit mentionner « {nom} » (hors commentaires).")
    elif mode == "readme-requirements":
        if not re.search(r"requirements\.txt", markdown_utile("README.md")):
            echec("README.md doit citer `requirements.txt` (hors commentaires) pour dire qu'il fait foi.")
        if Path("requirements-old.txt").exists():
            echec("requirements-old.txt existe encore : supprime-le.")
    else:
        echec(__doc__)
    ok()


COMMANDES = {"sortie": cmd_sortie, "couverture": cmd_couverture, "tests": cmd_tests, "palier": cmd_palier,
             "code": cmd_code, "react": cmd_react, "renovate": cmd_renovate, "doc": cmd_doc}

