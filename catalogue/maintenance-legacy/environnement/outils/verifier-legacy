def cmd_sortie(args):
    inchange = "--inchange" in args
    args = [a for a in args if a != "--inchange"]
    if len(args) != 2 or args[1] not in REFERENCES:
        echec(__doc__)
    fichier = args[0]
    dossier, flux, commande = REFERENCES[args[1]]
    ref = OPT / dossier
    contenu = lire(fichier)
    with tempfile.TemporaryDirectory() as tmp:
        res = subprocess.run(["sh", "-c", commande], cwd=ref, env=env_propre(tmp), capture_output=True, text=True,
                             timeout=20)
    attendu = {"out": res.stdout, "err": res.stderr, "tout": res.stdout + res.stderr}[flux]
    lignes = {normaliser(l) for l in contenu.splitlines() if l.strip()}
    manquantes = [l for l in attendu.splitlines() if l.strip() and normaliser(l) not in lignes]
    if not attendu.strip():
        echec("La commande de référence n'a rien produit : vérification impossible.", 2)
    if manquantes:
        echec(f"{fichier} ne contient pas la sortie réelle de la commande. Il manque par exemple la ligne :\n  "
              + manquantes[0] + "\nLance la commande et redirige sa sortie (> ou 2>) vers le fichier.")
    if inchange:
        for source in ref.rglob("*"):
            if source.is_file() and "__pycache__" not in source.parts:
                cible = Path(source.relative_to(ref))
                if not cible.is_file() or cible.read_bytes() != source.read_bytes():
                    echec(f"Le fichier {cible} du projet a été modifié ou supprimé : l'état des lieux se fait sans "
                          "rien changer au projet.")
    ok()


# ── 2. Couverture ────────────────────────────────────────────────────────────────────────────────────────────────
def python_venv(nom):
    return str(VENVS / nom / "bin" / "python")


def copie_projet(tmp, tests=None):
    copie = Path(tmp) / "p"
    shutil.copytree(PROJET, copie, ignore=IGNORER)
    if tests is not None:
        shutil.copy2(tests, copie / "adherents" / "tests.py")
    return copie


def rapport_couverture(copie, tmp, venv="django31"):
    env = env_propre(tmp)
    py = python_venv(venv)
    subprocess.run([py, "-s", "-E", "-m", "coverage", "run", "manage.py", "test"], cwd=copie, env=env,
                   capture_output=True, text=True, timeout=60)
    res = subprocess.run([py, "-s", "-E", "-m", "coverage", "report"], cwd=copie, env=env, capture_output=True, text=True,
                         timeout=30)
    return res.stdout


LIGNE_COUV = re.compile(r"^(\S+)\s+(\d+)\s+(\d+)\s+(\d+)%\s*$", re.M)


def tableau(texte):
    return {m.group(1): tuple(int(m.group(i)) for i in (2, 3, 4)) for m in LIGNE_COUV.finditer(texte)}


def cmd_couverture(args):
    avec_tests = "--avec-tests" in args
    minimum = None
    if "--minimum" in args:
        minimum = int(args[args.index("--minimum") + 1])
    fichier = [a for a in args if not a.startswith("--") and not a.isdigit()][0]
    appris = tableau(lire(fichier))
    with tempfile.TemporaryDirectory() as tmp:
        if avec_tests:
            travail = Path("adherents/tests.py")
            if not travail.is_file():
                echec("adherents/tests.py est introuvable.")
            copie = copie_projet(tmp, travail)
        else:
            copie = copie_projet(tmp)
        reference = tableau(rapport_couverture(copie, tmp))
    if not reference or "TOTAL" not in reference:
        echec("Impossible de produire la couverture de référence.", 2)
    if set(appris) != set(reference):
        echec("Le rapport ne ressemble pas à la sortie de `coverage report` pour ce projet : relance la commande "
              "et redirige sa sortie avec `>`.")
    for nom, (stmts, manque, cover) in appris.items():
        if stmts != reference[nom][0]:
            echec(f"Le nombre de lignes de {nom} ({stmts}) ne correspond pas au projet : rapport recopié ou périmé ?")
        if manque > stmts or abs(cover - ((stmts - manque) * 100 / stmts if stmts else 100)) > 1:
            echec(f"Les chiffres de la ligne {nom} ne sont pas cohérents : ce n'est pas la sortie de coverage.")
    total = appris["TOTAL"]
    somme = [sum(v[i] for k, v in appris.items() if k != "TOTAL") for i in (0, 1)]
    if [total[0], total[1]] != somme:
        echec("La ligne TOTAL ne correspond pas à la somme des fichiers.")
    if minimum is not None:
        if total[2] < minimum:
            echec(f"La couverture du rapport est de {total[2]} % : il en faut au moins {minimum} %.")
        if reference["TOTAL"][2] < minimum:
            echec(f"Avec tes tests, la couverture rejouée est de {reference['TOTAL'][2]} % : il en faut au moins "
                  f"{minimum} %.")
    ok()


# ── 3. Tests écrits par l'apprenant·e : AST + mutations ─────────────────────────────────────────────────────────
def trivial(expr):
    return isinstance(expr, ast.Constant)


def assertions_reelles(methode):
    n = 0
    for noeud in ast.walk(methode):
        if isinstance(noeud, ast.Assert) and not trivial(noeud.test):
            n += 1
        elif (isinstance(noeud, ast.Call) and isinstance(noeud.func, ast.Attribute)
              and noeud.func.attr.startswith("assert") and isinstance(noeud.func.value, ast.Name)
              and noeud.func.value.id == "self"):
            if noeud.args and all(trivial(a) for a in noeud.args):
                continue  # assertTrue(True), assertEqual(1, 1)…
            n += 1
    return n


def appels_client(methode):
    """Chemins passés à self.client.get(...)."""
    chemins = []
    for noeud in ast.walk(methode):
        if (isinstance(noeud, ast.Call) and isinstance(noeud.func, ast.Attribute) and noeud.func.attr == "get"
                and isinstance(noeud.func.value, ast.Attribute) and noeud.func.value.attr == "client"
                and noeud.args and isinstance(noeud.args[0], ast.Constant) and isinstance(noeud.args[0].value, str)):
            chemins.append(noeud.args[0].value)
    return chemins


def utilise_patch(methode):
    for noeud in ast.walk(methode):
        if isinstance(noeud, ast.Call):
            f = noeud.func
            if (isinstance(f, ast.Name) and f.id == "patch") or (isinstance(f, ast.Attribute) and (
                    f.attr == "patch" or (isinstance(f.value, ast.Attribute) and f.value.attr == "patch"))):
                return True
    return False


def appelle(methode, nom):
    return any(isinstance(n, ast.Call) and isinstance(n.func, ast.Attribute) and n.func.attr == nom
               for n in ast.walk(methode))


